{
  "name": "creeper-bot",
  "version": "4.0.17",
  "engines": {
    "node": "22.x"
  },
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --ignore src/Fortnite/FortniteSprites/spriteData.json --ignore src/Fortnite/FortniteMap/mapData.json --exec ts-node src/index.ts",
    "prod": "node dist/index.js",
    "build": "tsc",
    "test": "nodemon --exec ts-node src/scripts/test.ts",
    "fetch-map": "ts-node src/scripts/fetchMapData.ts",
    "fetch-map-assets": "ts-node src/scripts/fetchMapAssets.ts",
    "upload-map-assets": "ts-node src/scripts/uploadMapAssetsToDiscord.ts",
    "fetch-sprites": "ts-node src/scripts/fetchSpriteData.ts",
    "heroku-postbuild": "npm run build && mkdir -p ./.cache && mv /app/.cache/puppeteer ./.cache"
  },
  "author": "Creeper",
  "license": "ISC",
  "dependencies": {
    "@discordjs/builders": "^0.12.0",
    "@napi-rs/canvas": "^1.0.0",
    "@types/axios": "^0.14.0",
    "@types/express": "^4.17.14",
    "@types/node": "^18.6.4",
    "@types/node-schedule": "^1.3.2",
    "@types/puppeteer": "^5.4.5",
    "@types/uuid": "^9.0.0",
    "axios": "^0.26.0",
    "cheerio": "^1.0.0-rc.12",
    "chrome-aws-lambda": "^10.1.0",
    "discord.js": "^13.6.0",
    "dotenv": "^16.0.0",
    "express": "^4.18.1",
    "fuse.js": "^6.6.2",
    "mongoose": "^5.13.8",
    "node-schedule": "^2.1.0",
    "nodemon": "^2.0.15",
    "puppeteer": "^25.1.0",
    "ts-node": "^10.5.0",
    "twitter-api-v2": "^1.12.9",
    "typescript": "^4.6.2",
    "uuid": "^9.0.0"
  }
}
