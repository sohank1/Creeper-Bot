# Production deployment uses production; use development for local npm run dev.
NODE_ENV=production
HOST_TYPE=oracle
PORT=3001

BOT_TOKEN=
DEV_BOT_TOKEN=
MONGO_URI=

# Optional
REDIS_URI=
FORTNITE_API_KEY=
# Optional override for the direct ranked-data fallback used when FortniteTracker challenges Puppeteer.
FORTNITE_RANKED_API_URL=
FORTNITE_MAP_API_KEY=
# Persistent VPS paths for sprite season archives/history. These must point to
# storage that survives Coolify/container redeploys when configured in production.
FORTNITE_SPRITE_ARCHIVE_DIR=
FORTNITE_SPRITE_HISTORY_PATH=
# Optional storage namespace. Local development derives this from the Git
# branch; production should set one stable value per deployed branch.
FORTNITE_SPRITE_STORAGE_NAMESPACE=
# Used only to label the pre-history spriteData.json on first migration.
FORTNITE_SPRITE_LEGACY_SEASON_ID=chapter-7-season-3
# Optional Linux-only filesystem copy of immutable per-season archives. In
# Docker, this is the container path; docker-compose binds it to a VPS host
# directory.
FORTNITE_SPRITE_ARCHIVE_BACKUP_DIR=
# Fail a Linux season rollover if a configured backup is missing or incomplete.
FORTNITE_SPRITE_ARCHIVE_BACKUP_REQUIRED=false
# Host-side path used by docker-compose for the bind mount.
FORTNITE_SPRITE_ARCHIVE_BACKUP_HOST_DIR=/var/lib/creeper-bot/fortnite-sprite-archives
# Optional Linux-only off-site Backblaze B2 Native API copy. Use a standard
# bucket-scoped application key in production when possible. The master key is
# accepted by the Native API, but its key ID is required too.
FORTNITE_SPRITE_ARCHIVE_B2_KEY_ID=
FORTNITE_SPRITE_ARCHIVE_B2_APPLICATION_KEY=
FORTNITE_SPRITE_ARCHIVE_B2_BUCKET=
# Optional: setting this avoids the b2_list_buckets lookup for restricted keys.
FORTNITE_SPRITE_ARCHIVE_B2_BUCKET_ID=
FORTNITE_SPRITE_ARCHIVE_B2_PREFIX=
# Optional: normally leave blank; the Native API supplies the storage URL.
FORTNITE_SPRITE_ARCHIVE_B2_API_URL=
# Optional overrides for the shared current-snapshot seed/cache paths. Production
# defaults point at the persistent cache paths shown in the README.
FORTNITE_SPRITE_DATA_PATH=
FORTNITE_SPRITE_ASSET_CACHE_DIR=
FORTNITE_SPRITE_ASSET_CACHE_VERSION=v4-binary-assets
FORTNITE_SPRITE_ARCHIVE_ASSET_CONCURRENCY=4
FORTNITE_SPRITE_ARCHIVE_CURRENT_KEY=
TWITTER_BEARER_TOKEN=
